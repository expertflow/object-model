{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/expertflow/object-model/schemas/v1/button.json",
  "title": "Button",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "additionalButtonDetails": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "title",
    "payload",
    "type"
  ]
}
