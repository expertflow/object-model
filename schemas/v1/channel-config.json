    },
    "routingPolicy": {
      "$ref": "routing-policy.json"
    },
    "botId": {
      "type": "string"
    }
  },
  "required": [
    "channelMode",
    "responseSla",
    "customerActivityTimeout",
    "customerIdentificationCriteria",
    "routingPolicy",
    "botId"
